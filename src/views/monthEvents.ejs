<%- include('./partials/header') %>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Relatório: <%= title %></h2>
        <a href="/admin/dashboard" class="btn btn-dark btn-sm rounded-3 shadow-sm">
            <i class="bi bi-house-door me-1"></i> Voltar
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="ps-4">Membro / Responsável</th>
                        <th>Valor Arrecadado (R$)</th>
                        <th class="text-center">Mês</th>
                        <th class="text-end pe-4">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    <% patios.forEach(item => { %>
                        <tr>
                            <form action="<%= title === 'Patios' ? '/admin/patioupdate' : '/admin/prayercircleupdate' %>" method="POST">
                                <input type="hidden" name="id" value="<%= item.id %>">
                                
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        <strong><%= item.member || 'Aguardando...' %></strong>
                                    </div>
                                </td>

                                <td style="width: 200px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white border-end-0">R$</span>
                                        <input type="number" step="0.01" name="value" 
                                               class="form-control border-start-0 ps-0" 
                                               value="<%= item.collected %>" required>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-light text-dark rounded-pill px-3 border">
                                        Mês <%= item.month %>
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <button type="submit" class="btn btn-success btn-sm rounded-3 px-3">
                                        <i class="bi bi-check-lg"></i> Salvar
                                    </button>
                                </td>
                            </form>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>