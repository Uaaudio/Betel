<%- include('./partials/header') %>

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4">
        
        <div class="text-center mb-4">
            <div class="bg-dark text-white d-inline-block p-3 rounded-circle shadow-sm mb-2">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Acesso Restrito</h3>
            <p class="text-muted">Identifique-se para gerenciar o Betel</p>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form action="/login" method="POST">
                    
                    <div class="mb-3">
                        <label for="email" class="form-label small fw-bold text-uppercase text-secondary">E-mail Corporativo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="login" class="form-control bg-light border-0 py-2" id="email" placeholder="email@igreja.com" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label small fw-bold text-uppercase text-secondary">Senha de Acesso</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-key"></i></span>
                            <input type="password" name="password" class="form-control bg-light border-0 py-2" id="password" placeholder="••••••••" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                    </button>
                    
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <small class="text-muted text-decoration-none">Problemas com acesso? Fale com o suporte.</small>
        </div>

    </div>
</div>

<%- include('./partials/footer') %>